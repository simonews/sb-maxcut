# Normalize line endings: LF in the repository and in the working tree, also on Windows.
* text=auto eol=lf
*.sh text eol=lf

# Binary files: no end-of-line conversion, no textual diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.xz binary
*.7z binary
*.tar binary
*.npy binary
*.npz binary
*.parquet binary
*.xlsx binary
*.nsys-rep binary
*.ncu-rep binary

# G-set files (data/gset/): kept byte for byte as published at Stanford, trailing space of the
# header and line endings included (G56, G60 and G61 have CRLF), so git never converts their line
# endings, whatever the rules above say.
data/gset/G* -text
