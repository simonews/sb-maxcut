# Normalize line endings: LF in the repository and in the working tree, also on Windows.
* text=auto eol=lf
*.sh text eol=lf

# Binary files: no end-of-line conversion, no textual diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.xz binary
*.7z binary
*.tar binary
*.npy binary
*.npz binary
*.parquet binary
*.xlsx binary
*.nsys-rep binary
*.ncu-rep binary
