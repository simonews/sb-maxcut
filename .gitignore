# Build trees (CMake presets and CLion)
build/
cmake-build-*/

# IDEs and tool caches
.idea/
.vscode/
.cache/

# Python
.venv/
__pycache__/
*.pyc

# Machine-specific presets, generated by scripts/setup_cuda_pypi.sh
CMakeUserPresets.json

# Raw data and raw results (summaries and CSV files in results/ are versioned)
data/raw/
results/**/raw/

# Profiler reports
*.nsys-rep
*.ncu-rep

# Files larger than 5 MB never go into git: .gitignore cannot express this rule, which is
# enforced by scripts/sync_from_zip.sh.
