# Writes <build>/generated/sbmc/build_info.hpp: the build information recorded in every row of the
# results (git hash, uncommitted changes, compiler, build type). Run with cmake -P at every build by
# the target sbmc_build_info (apps/CMakeLists.txt), never at configure time:
#
#   cmake -DSBMC_SOURCE_DIR=<repository root> -DSBMC_OUTPUT=<header> -DSBMC_GIT=<git or empty>
#         "-DSBMC_COMPILER=<id> <version>" -DSBMC_BUILD_TYPE=<type> -P cmake/sbmc_build_info.cmake
#
# - git_hash: "git rev-parse HEAD" (40 hexadecimal digits), or "unknown" when git is missing, the
#   folder is not a repository or the output is not a 40-digit hash;
# - dirty: 1 when a tracked file outside the folder results/ of the repository root has changes,
#   staged or not; 0 when no such file has; -1 when unknown. The command is
#     git -C <root> --no-optional-locks status --porcelain --untracked-files=no
#         -- . ":(exclude)results"
#   whose pathspecs are relative to the root: results/ of the root is ignored, while a results
#   folder elsewhere (sub/results/) and the files of the root whose name starts with "results"
#   (results_old.csv) still count. results/ holds the committed results of the measurements: a
#   row appended to one of its CSV files does not change the sources, so it must not mark the
#   build as dirty. --no-optional-locks keeps git status from rewriting the index of the
#   repository during the build.
# - Without git, or when the folder is not a repository (the copy of a commit built on Windows,
#   phase 07, part 4: scripts/windows/stage.sh), both come from <root>/.sbmc_build_info, when it
#   exists, with the lines git_hash=<40 hexadecimal digits> and dirty=<0|1> (written by
#   stage.sh from git rev-parse HEAD; ignored by git). A file with another content is an error.
# The header is rewritten only when its content changes: a build without changes recompiles
# nothing, and a change to a tracked file updates dirty at the next build without a configure.
cmake_minimum_required(VERSION 3.28)

foreach(_sbmc_required IN ITEMS SBMC_SOURCE_DIR SBMC_OUTPUT)
  if(NOT DEFINED ${_sbmc_required} OR "${${_sbmc_required}}" STREQUAL "")
    message(FATAL_ERROR "sbmc_build_info.cmake: ${_sbmc_required} is not set")
  endif()
endforeach()

set(_sbmc_hash "unknown")
set(_sbmc_dirty -1)
if(SBMC_GIT)
  execute_process(
    COMMAND "${SBMC_GIT}" -C "${SBMC_SOURCE_DIR}" rev-parse HEAD
    RESULT_VARIABLE _sbmc_result
    OUTPUT_VARIABLE _sbmc_output
    ERROR_QUIET
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(_sbmc_result EQUAL 0 AND _sbmc_output MATCHES "^[0-9a-f]+$")
    string(LENGTH "${_sbmc_output}" _sbmc_length)
    if(_sbmc_length EQUAL 40)
      set(_sbmc_hash "${_sbmc_output}")
    endif()
  endif()
  execute_process(
    COMMAND "${SBMC_GIT}" -C "${SBMC_SOURCE_DIR}" --no-optional-locks status --porcelain
            --untracked-files=no -- . ":(exclude)results"
    RESULT_VARIABLE _sbmc_result
    OUTPUT_VARIABLE _sbmc_output
    ERROR_QUIET)
  if(_sbmc_result EQUAL 0)
    if(_sbmc_output STREQUAL "")
      set(_sbmc_dirty 0)
    else()
      set(_sbmc_dirty 1)
    endif()
  endif()
endif()

# The copy of a commit without git: <root>/.sbmc_build_info.
set(_sbmc_info_file "${SBMC_SOURCE_DIR}/.sbmc_build_info")
if(_sbmc_hash STREQUAL "unknown" AND _sbmc_dirty EQUAL -1 AND EXISTS "${_sbmc_info_file}")
  file(STRINGS "${_sbmc_info_file}" _sbmc_lines)
  set(_sbmc_file_hash "")
  set(_sbmc_file_dirty "")
  foreach(_sbmc_line IN LISTS _sbmc_lines)
    if(_sbmc_line MATCHES "^git_hash=([0-9a-f]+)$")
      set(_sbmc_file_hash "${CMAKE_MATCH_1}")
    elseif(_sbmc_line MATCHES "^dirty=([01])$")
      set(_sbmc_file_dirty "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  string(LENGTH "${_sbmc_file_hash}" _sbmc_length)
  if(NOT _sbmc_length EQUAL 40 OR _sbmc_file_dirty STREQUAL "")
    message(FATAL_ERROR "sbmc_build_info.cmake: ${_sbmc_info_file} must have the lines "
                        "git_hash=<40 hexadecimal digits> and dirty=<0|1>")
  endif()
  set(_sbmc_hash "${_sbmc_file_hash}")
  set(_sbmc_dirty "${_sbmc_file_dirty}")
endif()

# Strings go into C++ string literals: backslashes and quotes are escaped.
foreach(_sbmc_name IN ITEMS SBMC_COMPILER SBMC_BUILD_TYPE)
  set(_sbmc_value "${${_sbmc_name}}")
  if(_sbmc_value STREQUAL "")
    set(_sbmc_value "unknown")
  endif()
  string(REPLACE "\\" "\\\\" _sbmc_value "${_sbmc_value}")
  string(REPLACE "\"" "\\\"" _sbmc_value "${_sbmc_value}")
  set(_sbmc_${_sbmc_name} "${_sbmc_value}")
endforeach()

string(CONCAT _sbmc_content
  "// Generated by cmake/sbmc_build_info.cmake at build time: do not edit.\n"
  "#pragma once\n"
  "\n"
  "#include <string_view>\n"
  "\n"
  "namespace sbmc::build_info {\n"
  "\n"
  "// git rev-parse HEAD of the source tree, or \"unknown\".\n"
  "inline constexpr std::string_view git_hash = \"${_sbmc_hash}\";\n"
  "// 1: uncommitted changes to tracked files outside results/ of the repository root; 0: none;"
  " -1: unknown.\n"
  "inline constexpr int dirty = ${_sbmc_dirty};\n"
  "// C++ compiler, \"<id> <version>\" from the configure step.\n"
  "inline constexpr std::string_view compiler = \"${_sbmc_SBMC_COMPILER}\";\n"
  "// CMake build type.\n"
  "inline constexpr std::string_view build_type = \"${_sbmc_SBMC_BUILD_TYPE}\";\n"
  "\n"
  "}  // namespace sbmc::build_info\n")

set(_sbmc_old "")
if(EXISTS "${SBMC_OUTPUT}")
  file(READ "${SBMC_OUTPUT}" _sbmc_old)
endif()
if(NOT _sbmc_old STREQUAL _sbmc_content)
  get_filename_component(_sbmc_folder "${SBMC_OUTPUT}" DIRECTORY)
  file(MAKE_DIRECTORY "${_sbmc_folder}")
  file(WRITE "${SBMC_OUTPUT}" "${_sbmc_content}")
  message(STATUS "build_info.hpp: git_hash ${_sbmc_hash}, dirty ${_sbmc_dirty}")
endif()
