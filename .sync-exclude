# .sync-exclude: paths that scripts/sync_from_zip.sh never copies from a delivery zip and never
# deletes from the working tree. Format: one rsync pattern per line (--exclude-from); lines
# starting with "#" are comments, and a trailing "# word" annotates the pattern before it (the
# sync script strips annotations before handing the patterns to rsync).
#
# Consistency rule: every pattern must also be ignored by git (.gitignore), except the ones
# annotated "# tracked" (versioned by git but owned by the user, never by deliveries) or
# "# internal" (git's own metadata). scripts/sync_from_zip.sh checks the rule before each sync.
#
# No trailing slash on .git: in a git worktree .git is a file, not a directory.
.git             # internal
build/
cmake-build-*/
.idea/
.vscode/
.venv/
.cache/
__pycache__/
data/raw/
# Generated by scripts/setup_cuda_pypi.sh: a sync must never delete it.
CMakeUserPresets.json
# Profiler reports saved outside results/.
*.nsys-rep
*.ncu-rep
results/         # tracked
